# Database Configuration
# Use PostgreSQL in production or development: postgresql://username:password@localhost:5432/polartwin
# SQLite fallback is automatically supported if set to sqlite:///./polar_twin.db or if PostgreSQL is not reachable locally.
DATABASE_URL=sqlite:///./polar_twin.db

# External Weather Service Configuration
WEATHER_API_KEY=
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Security & Authentication
SECRET_KEY=polar-digital-twin-hackathon-super-secret-key-2026

# Digital Twin Simulation Settings
SIMULATION_ENABLED=true
SIMULATION_INTERVAL_SECONDS=10

# Runtime Environment (development / staging / production)
ENVIRONMENT=development

# LLM & Copilot Configuration (Ollama, OpenAI, Gemini, Groq)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
