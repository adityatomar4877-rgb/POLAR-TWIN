# =========================================================
# Polar Twin Frontend - Production Environment Variables
# =========================================================
# Set these in your Vercel Project Settings -> Environment Variables

# 1. Backend REST API URL (HTTPS)
# Example: https://polar-twin-backend.onrender.com/api
VITE_API_URL=https://your-backend-service.onrender.com/api

# 2. Backend WebSocket Stream URL (WSS)
# Example: wss://polar-twin-backend.onrender.com/ws
VITE_WS_URL=wss://your-backend-service.onrender.com/ws

# 3. Default Operator Call-sign / ID
VITE_OPERATOR_ID=Operator_Antarctic_HQ
